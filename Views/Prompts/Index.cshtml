@model IEnumerable<PromptHub.Models.Prompt>

@{
    ViewData["Title"] = "Prompts";
}

<h1>AI Prompts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Prompt</a>
</p>

<!-- Search and Filter Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by title or content..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">All Categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="tagId" class="form-select" asp-items="ViewBag.Tags">
                <option value="">All Tags</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            }
                        </p>
                        <div class="mb-2">
                            <span class="badge bg-primary">@item.Category?.Name</span>
                        </div>
                        @if (item.PromptTags != null && item.PromptTags.Any())
                        {
                            <div class="mb-2">
                                @foreach (var pt in item.PromptTags.Take(3))
                                {
                                    <span class="badge bg-secondary me-1">@pt.Tag.Name</span>
                                }
                                @if (item.PromptTags.Count > 3)
                                {
                                    <span class="badge bg-light text-dark">+@(item.PromptTags.Count - 3)</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <small class="text-muted">
                            Created: @item.CreatedAt.ToString("MMM dd, yyyy") | 
                            Updated: @item.UpdatedAt.ToString("MMM dd, yyyy")
                        </small>
                        <div class="mt-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                No prompts found. <a asp-action="Create">Create a new prompt</a>
            </div>
        </div>
    }
</div>
