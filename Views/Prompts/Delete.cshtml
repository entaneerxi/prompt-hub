@model PromptHub.Models.Prompt

@{
    ViewData["Title"] = "Delete Prompt";
}

<h1>Delete Prompt</h1>

<h3>Are you sure you want to delete this?</h3>
<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>

            <dt class="col-sm-3">Tags</dt>
            <dd class="col-sm-9">
                @if (Model.PromptTags != null && Model.PromptTags.Any())
                {
                    @foreach (var pt in Model.PromptTags)
                    {
                        <span class="badge bg-secondary me-1">@pt.Tag.Name</span>
                    }
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
